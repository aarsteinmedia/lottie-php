{
  "name": "aarsteinmedia/lottie-php",
  "version": "0.1.0",
  "autoload": {
    "psr-4": {
      "LottiePHP\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LottiePHP\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11",
    "spatie/phpunit-watcher": "^1.24",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "scripts": {
    "test": "phpunit",
    "test:watch": "phpunit-watcher watch",
    "lint": "php-cs-fixer fix --dry-run --diff src",
    "lint:fix": "php-cs-fixer fix src"
  }
}
