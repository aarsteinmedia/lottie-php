{
  "name": "aarsteinmedia/lottie-php",
  "description": "Create still SVGs from Lottie Animations on the backend, for previews.",
  "autoload": {
    "psr-4": {
      "LottiePHP\\": "src/"
    },
    "files": [
      "src/Utils/index.php",
      "src/Utils/Enums.php",
      "src/Utils/buildShapeString.php",
      "src/Utils/getFontProperties.php",
      "src/Utils/DotLottie/getAnimationData.php",
      "src/Utils/DotLottie/getLottieJSON.php",
      "src/Utils/DotLottie/resolveAssets.php",
      "src/Utils/Pooling/bezierLengthPool.php",
      "src/Utils/Pooling/domDocumentPool.php",
      "src/Utils/Pooling/double.php",
      "src/Utils/Pooling/pointPool.php",
      "src/Utils/Pooling/segmentLengthPool.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "LottiePHP\\Tests\\": "tests/"
    }
  },
  "require": {
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-zip": "*",
    "php": ">=8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpunit/phpunit": "^10.5 || ^11 || ^12 || ^13.4"
  },
  "scripts": {
    "lint": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff src tests",
    "lint:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php src tests",
    "test": "phpunit",
    "test:update-snapshots": [
      "@putenv UPDATE_SNAPSHOTS=1",
      "phpunit --filter SnapshotTest"
    ],
    "visual:up": "composer dump-autoload && docker compose up --build -d && docker compose ps && open -a Firefox 'http://localhost:8000'",
    "visual:down": "docker compose down",
    "visual:logs": "docker compose logs -f --tail=200",
    "visual:sh": "docker compose exec visual sh"
  }
}
